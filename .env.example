# Atelier NOIRÉ Environment Configuration

# RESEND: Transactional Email Delivery
# 1. Obtain your API key from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
# 2. Add your custom brand domain at https://resend.com/domains (e.g. atelier-noire.com)
#    and configure the 3 DNS records (DKIM, SPF, DMARC) in your domain registrar.
#    This allows sending live confirmation emails directly to any customer's inbox worldwide.
RESEND_FROM_EMAIL=your_verified_email@example.com

# FIREBASE ADMIN SDK: Privileged Serverless Operations (Phase 1)
# On Vercel, you can provide either the full JSON string or individual values:
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY=your_firebase_private_key

# Optional alternative: JSON stringified service account
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'

# Application URLs
APP_URL=http://localhost:3000
PORT=3000
